<Window x:Class="SwiftBatchApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SWIFT Batch Processor"
        Width="1340" Height="860" MinWidth="1060" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================================ navigation rail -->
        <Border Background="{StaticResource CharcoalBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,20">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{StaticResource CharcoalBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SWIFT Batch" Foreground="White" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="MT101 processor" Foreground="#9A9AA5" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="12,12,12,14" Padding="12,10" CornerRadius="8" Background="{StaticResource CharcoalLightBrush}">
                    <StackPanel>
                        <TextBlock x:Name="UserNameText" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="UserEmailText" Foreground="#9A9AA5" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Border x:Name="RoleBadge" CornerRadius="9" Padding="8,1" Background="{StaticResource AccentBrush}">
                                <TextBlock x:Name="RoleText" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource CharcoalBrush}"/>
                            </Border>
                            <Button Content="Switch account" Style="{StaticResource LinkButton}" Margin="12,0,0,0" FontSize="11.5"
                                    VerticalAlignment="Center" Click="SwitchAccount_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Dashboard" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavProcessing" Style="{StaticResource NavItem}" Tag="&#xE768;" Content="Processing" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavPayments" Style="{StaticResource NavItem}" Tag="&#xE8FD;" Content="Payments" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavRegistry" Style="{StaticResource NavItem}" Tag="&#xE8A5;" Content="Registry" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavClients" Style="{StaticResource NavItem}" Tag="&#xE716;" Content="Clients" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavStatistics" Style="{StaticResource NavItem}" Tag="&#xE9D2;" Content="Statistics" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavUsers" Style="{StaticResource NavItem}" Tag="&#xE77B;" Content="Users" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="About" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================================================================ content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="NoticeBanner" Style="{StaticResource Banner}" Margin="24,16,24,0" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Locate registry…" Margin="12,0,0,0" Click="LocateRegistry_Click"/>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentDarkBrush}" FontSize="16" Margin="0,0,10,0"/>
                    <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <ContentControl x:Name="ViewHost" Grid.Row="1" Focusable="False"/>

            <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,6">
                <DockPanel>
                    <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Style="{StaticResource Muted}" Margin="18,0,0,0"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="EngineDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="EngineText" Style="{StaticResource Muted}" Margin="0,0,20,0"/>
                        <TextBlock x:Name="RefreshText" Style="{StaticResource Muted}" Margin="0,0,20,0"/>
                        <TextBlock x:Name="RegistryText" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

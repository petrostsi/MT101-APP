<Window x:Class="SwiftBatchApp.Views.ReassignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reassign file"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PageBrush}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="22">
        <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" FontSize="17"/>
        <TextBlock x:Name="InfoText" Style="{StaticResource Muted}" Margin="0,0,0,14"/>

        <TextBlock Text="New assignee" Style="{StaticResource Muted}"/>
        <ComboBox x:Name="UserCombo" DisplayMemberPath="Label" Margin="0,2,0,12"/>

        <CheckBox x:Name="SendMailCheck" Content="E-mail the archived file to the new assignee (Outlook)" IsChecked="True"/>
        <TextBlock x:Name="MailHint" Style="{StaticResource Muted}" FontSize="11.5" Margin="22,2,0,0"/>

        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,14,0,0"
                   Text="Column A of the day workbook and the registry are rewritten. ESCALATED / NO MATCH files become Pending."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Reassign" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

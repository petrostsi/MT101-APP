<Window x:Class="SwiftBatchApp.Views.IdentityPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Who are you? — SWIFT Batch Processor"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        Background="{StaticResource PageBrush}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="22">
        <TextBlock Text="Who are you?" Style="{StaticResource PageTitle}"/>
        <TextBlock x:Name="IntroText" Style="{StaticResource PageSubtitle}" Margin="0,6,0,14"/>

        <Border Style="{StaticResource Card}" Padding="8">
            <ListBox x:Name="UserList" Height="220" BorderThickness="0" DisplayMemberPath="Label" MouseDoubleClick="UserList_DoubleClick"/>
        </Border>

        <StackPanel x:Name="ManualPanel" Visibility="Collapsed" Margin="0,10,0,0">
            <TextBlock Text="Your e-mail address (the team list is not reachable right now)" Style="{StaticResource Muted}"/>
            <TextBox x:Name="ManualEmail"/>
        </StackPanel>

        <Border Style="{StaticResource Banner}" Margin="0,14,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Claim manager" Margin="10,0,0,0" Click="ClaimManager_Click"/>
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Manager? Claiming makes this Windows account the manager: it runs the engine and sees everyone's work."/>
            </DockPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="This is me" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

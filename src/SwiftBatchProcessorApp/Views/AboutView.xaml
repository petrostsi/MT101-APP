<UserControl x:Class="SwiftBatchApp.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" MaxWidth="980" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/app.png" Width="48" Height="48" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SWIFT Batch Processor" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="What it does" Style="{StaticResource SectionTitle}"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="20">
                        Watches the shared folder for SWIFT MT101 print files (.prt), extracts every payment order, and e-mails each file to ONE processor —
                        the active user with the fewest payment orders today (ties broken at random). If that user's Outlook answers with an automatic
                        out-of-office reply, the file goes to the next user; if nobody is available it is escalated to the manager. Each file is archived
                        to ArchiveRoot\YYYY\MM\DD, logged as one row in Registry.xlsx and as one row per payment in PaymentOrders_YYMMDD.xlsx.
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Business rules" Style="{StaticResource SectionTitle}"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="20">
                        • One file = one user, even when it holds many payments; exactly one final e-mail per file.<LineBreak/>
                        • Duplicates (same file name) are never e-mailed again — they are moved to the day's Duplicates folder.<LineBreak/>
                        • Files arriving after the cut-off, on weekends or holidays wait in the next working day's folder and are sent at the deferred send time.<LineBreak/>
                        • Ordering customers are validated against the master customer file (IBAN + sender BIC + name); unknown customers go to the manager as NO MATCH.<LineBreak/>
                        • A payment is MTF when its creditor bank BIC (57A, else 59A) is exactly PIRBGRAA / PIRBGRAAXXX; otherwise MT103.<LineBreak/>
                        • A file is Completed when all of its payments are completed.<LineBreak/>
                        • If a workbook is open in Excel, rows are queued and written at the next cycle — nothing is lost.
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="This PC" Style="{StaticResource SectionTitle}"/>
                    <TextBox x:Name="EnvironmentText" Style="{StaticResource SelectableText}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Open program folder" Margin="0,0,8,0" Click="OpenAppFolder_Click"/>
                        <Button Content="Open registry folder" Margin="0,0,8,0" Click="OpenRegistryFolder_Click"/>
                        <Button Content="Open log folder" Click="OpenLogs_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

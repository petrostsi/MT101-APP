<UserControl x:Class="SwiftBatchApp.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Users" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Processors who receive files. Assignment is fair and random: the active user with the fewest payment orders today gets the next file; users out of office today are skipped."/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,16,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Toggle out of office today" Margin="0,0,8,0" Click="ToggleOoo_Click"/>
                <Button Content="Activate / deactivate" Margin="0,0,8,0" Click="ToggleActive_Click"/>
                <Button Content="Delete" Margin="0,0,8,0" Click="Delete_Click"/>
                <Button Content="Edit…" Margin="0,0,8,0" Click="Edit_Click"/>
                <Button Content="Add user…" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
            </StackPanel>
            <TextBlock x:Name="CountText" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>

        <DataGrid x:Name="UsersGrid" Grid.Row="2" Style="{StaticResource GridBase}" SelectionMode="Single" MouseDoubleClick="UsersGrid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="260" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="200" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Windows user" Binding="{Binding WindowsUser}" Width="150" ElementStyle="{StaticResource CellMono}"/>
                <DataGridTemplateColumn Header="Active" SortMemberPath="IsActive" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,7,0" Fill="{Binding ActiveKey, Converter={StaticResource StatusBrush}}"/>
                                <TextBlock Text="{Binding ActiveText}" Style="{StaticResource CellText}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Today" SortMemberPath="OooToday" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,7,0" Fill="{Binding TodayKey, Converter={StaticResource StatusBrush}}"/>
                                <TextBlock Text="{Binding TodayText}" Style="{StaticResource CellText}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Orders today" Binding="{Binding LoadToday}" Width="100" ElementStyle="{StaticResource CellNumber}"/>
                <DataGridTextColumn Header="" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="ManagerText"/>
                <TextBox x:Name="TeamFileText" Style="{StaticResource SelectableText}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

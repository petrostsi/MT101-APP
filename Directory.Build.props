<Project>
  <!-- Shared by every project. The version lives HERE ONLY: the UI reads it from the assembly. -->
  <PropertyGroup>
    <Version>2.5.0</Version>
    <Product>SWIFT Batch Processor</Product>
    <Copyright>Internal tool</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets the WPF project build on Linux/macOS (CI, Claude Code containers). Harmless on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
